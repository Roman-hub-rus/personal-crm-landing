---
import { APP_URL } from "../config";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={APP_URL}
  class:list={[
    "flex h-14.5 items-center justify-between rounded-full bg-accent pr-2 pl-5.5 text-17 font-semibold text-bg",
    "lg:h-15.5 lg:justify-start lg:gap-7 lg:pr-2.25 lg:pl-7 lg:text-18",
    className,
  ]}
>
  Добавить первый контакт
  <span class="flex size-10.5 items-center justify-center rounded-full bg-bg lg:size-11" aria-hidden="true">
    <svg class="ml-0.75 h-3.5 w-2.75 text-accent" viewBox="0 0 11 14">
      <path d="M0 0L11 7L0 14Z" fill="currentColor"></path>
    </svg>
  </span>
</a>
